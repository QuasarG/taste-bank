---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
// 首页改为客户端渲染：Astro 只输出静态壳，JS fetch /api/styles.json 填充 cover flow。
// 无 SSR 数据拉取、无 iframe → 首屏极快，滚轮切换无延迟。
---

<Base title="Taste Bank">
  <section class="cover-flow-section">
    <!-- 顶部标题区 -->
    <div class="cover-header">
      <h1 data-ui-en>TASTE BANK</h1>
      <h1 data-ui-zh style="display:none">TASTE BANK</h1>
      <p data-ui-en>The front-end style library for coding agents — swipe, pick, hand to your agent.</p>
      <p data-ui-zh style="display:none">面向 coding agent 的前端风格库——刷到心仪的风格，交给你的 agent。</p>
    </div>

    <!-- cover flow 容器（JS 填充） -->
    <div class="cover-flow" id="cover-flow">
      <div class="cover-loading" id="cover-loading">
        <span>Loading styles…</span>
      </div>
    </div>

    <!-- 焦点图信息（JS 更新） -->
    <div class="cover-info" id="cover-info" hidden>
      <a class="cover-info-name" id="cover-name" href="#">—</a>
      <p class="cover-info-summary" id="cover-summary">—</p>
      <div class="cover-info-tags" id="cover-tags"></div>
      <div class="cover-hint" data-ui-en>Scroll to browse · Click to view detail</div>
      <div class="cover-hint" data-ui-zh style="display:none">滚轮浏览 · 点击查看详情</div>
    </div>
  </section>

  <!-- 引用榜（客户端 fetch，保持 SSR 友好的 noscript fallback） -->
  <section class="top-refs-section" id="top-refs-section" hidden>
    <h2 data-ui-en>Most Referenced</h2>
    <h2 data-ui-zh style="display:none">最多引用</h2>
    <div class="top-refs-list" id="top-refs-list"></div>
  </section>

  <script>
    (async () => {
      const flow = document.getElementById('cover-flow');
      const loading = document.getElementById('cover-loading');
      const info = document.getElementById('cover-info');
      const nameEl = document.getElementById('cover-name');
      const summaryEl = document.getElementById('cover-summary');
      const tagsEl = document.getElementById('cover-tags');
      let items = [];
      let focus = 0;
      let railLock = false;

      try {
        const resp = await fetch('/api/styles.json');
        const data = await resp.json();
        items = data.styles || [];
      } catch {
        if (loading) loading.innerHTML = '<span>Failed to load. Visit /collections</span>';
        return;
      }

      if (items.length === 0) {
        if (loading) loading.innerHTML = '<span>No styles yet.</span>';
        return;
      }

      // 渲染 cover flow 卡片
      if (loading) loading.remove();
      flow.innerHTML = '';
      const cards = items.map((s, i) => {
        const card = document.createElement('div');
        card.className = 'cover-card';
        card.dataset.index = String(i);
        card.dataset.slug = s.slug;
        card.dataset.name = s.name;
        card.dataset.summary = s.summary || '';
        card.dataset.mood = (s.mood || []).join(', ');
        card.innerHTML = `<img src="/api/styles/${s.slug}/screenshot.png" alt="${s.name}" loading="${i < 3 ? 'eager' : 'lazy'}" decoding="async" />`;
        card.addEventListener('click', () => {
          if (Number(card.dataset.index) !== focus) {
            focus = Number(card.dataset.index);
            layout();
          } else {
            window.location.href = `/styles/${s.slug}`;
          }
        });
        flow.appendChild(card);
        return card;
      });

      info.hidden = false;

      function layout() {
        const n = cards.length;
        cards.forEach((card, i) => {
          let offset = i - focus;
          // 环绕：让相邻的图总是在两边
          if (offset > n / 2) offset -= n;
          if (offset < -n / 2) offset += n;
          const abs = Math.abs(offset);
          const sign = Math.sign(offset);
          if (abs > 3) {
            card.style.display = 'none';
            return;
          }
          card.style.display = '';
          const scale = abs === 0 ? 1 : 0.68 - abs * 0.06;
          const translateX = sign * (abs * 42); // vw 百分比偏移
          const opacity = abs === 0 ? 1 : Math.max(0.12, 0.45 - abs * 0.12);
          const blur = abs === 0 ? 0 : abs * 1.5;
          card.style.transform = `translateX(${translateX}vw) scale(${scale})`;
          card.style.opacity = String(opacity);
          card.style.filter = `blur(${blur}px)`;
          card.style.zIndex = String(100 - abs);
          card.classList.toggle('is-focus', abs === 0);
        });
        // 更新信息区
        const s = items[focus];
        nameEl.textContent = s.name;
        nameEl.href = `/styles/${s.slug}`;
        summaryEl.textContent = s.summary || '';
        tagsEl.innerHTML = (s.mood || []).map((m) => `<span class="cover-tag">${m}</span>`).join('');
      }

      layout();

      // 滚轮横移（节流 150ms）
      flow.addEventListener(
        'wheel',
        (e) => {
          // 只在 cover flow 区域拦截垂直滚轮
          const rect = flow.getBoundingClientRect();
          if (e.clientY < rect.top || e.clientY > rect.bottom) return;
          e.preventDefault();
          if (railLock) return;
          if (Math.abs(e.deltaY) < 8 && Math.abs(e.deltaX) < 8) return;
          railLock = true;
          const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          focus = (focus + (delta > 0 ? 1 : -1) + items.length) % items.length;
          layout();
          setTimeout(() => { railLock = false; }, 150);
        },
        { passive: false },
      );

      // 键盘左右
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { focus = (focus - 1 + items.length) % items.length; layout(); }
        if (e.key === 'ArrowRight') { focus = (focus + 1) % items.length; layout(); }
      });

      // 触摸滑动（移动端）
      let touchStartX = 0;
      flow.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
      flow.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40 && !railLock) {
          railLock = true;
          focus = (focus + (dx < 0 ? 1 : -1) + items.length) % items.length;
          layout();
          setTimeout(() => { railLock = false; }, 150);
        }
      });

      // 引用榜（可选，失败不崩）
      try {
        const resp = await fetch('/api/styles.json');
        // 暂时复用列表（usage 榜需要单独端点，先不展示 refs section）
        // 如需启用引用榜，加 GET /api/top-refs 端点后填充
      } catch {}
    })();
  </script>
</Base>
