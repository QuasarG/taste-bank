---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
// About 页：一屏不滚动。CLI 突出（主区域），MCP 折叠（副区域），底部申请邀请码表单。
---

<Base title="Quick Start" titleZh="快速开始" description="How to use Taste Bank with your coding agent." wide>
  <div class="subpage about-page-compact">
    <!-- 左：CLI 突出（主区域） -->
    <section class="about-main">
      <header class="about-intro-compact">
        <p class="eyebrow"><span data-ui-en>Quick Start</span><span data-ui-zh>快速开始</span></p>
        <h1>
          <span data-ui-en>Visual taste, made usable.</span>
          <span data-ui-zh style="display:none">视觉品味，即刻可用。</span>
        </h1>
      </header>

      <div class="about-cli-block">
        <p class="about-cli-label">
          <span data-ui-en>One command sets you up:</span>
          <span data-ui-zh style="display:none">一行命令完成配置：</span>
        </p>
        <div class="terminal-window">
          <div class="terminal-titlebar">
            <span class="terminal-dot terminal-dot-red"></span>
            <span class="terminal-dot terminal-dot-yellow"></span>
            <span class="terminal-dot terminal-dot-green"></span>
            <span class="terminal-title">zsh — taste-bank</span>
          </div>
          <div class="terminal-body">
            <div class="terminal-line"><span class="t-prompt">➜</span> <span class="t-path">~</span> <span class="t-cmd">npx</span> <span class="t-arg">taste-bank setup</span><span class="t-cursor-block"></span></div>
          </div>
        </div>
        <p class="about-cli-desc">
          <span data-ui-en>Installs the CLI globally and teaches your coding agent (Claude Code, Codex, Cursor, ZCode, Kimi Code…) how to browse and apply styles.</span>
          <span data-ui-zh style="display:none">全局安装 CLI，并教会你的 coding agent 怎么浏览和取用风格。</span>
        </p>
        <div class="about-cli-commands">
          <code>taste-bank list</code>
          <code>taste-bank skill &lt;slug&gt;</code>
          <code>taste-bank use &lt;slug&gt;</code>
          <code>taste-bank submit &lt;pack&gt;</code>
        </div>
      </div>

      <!-- MCP 折叠（副区域） -->
      <details class="about-mcp-collapse">
        <summary>
          <span data-ui-en>Use via MCP instead (legacy)</span>
          <span data-ui-zh style="display:none">改用 MCP（兼容方式）</span>
        </summary>
        <p class="about-mcp-note">
          <span data-ui-en>For agents that prefer the MCP protocol, configure one URL:</span>
          <span data-ui-zh style="display:none">偏好 MCP 协议的 agent，配置一条 URL：</span>
        </p>
        <pre class="about-mcp-config" set:html={`{
  "mcpServers": {
    "taste-bank": {
      "url": "https://tastebank.cloud/mcp",
      "headers": { "x-invite-code": "sl_your_invite_code" }
    }
  }
}`}></pre>
        <p class="about-mcp-note">
          <span data-ui-en>Browsing needs no invite code; submitting requires one. Both CLI and MCP call the same backend.</span>
          <span data-ui-zh style="display:none">浏览无需邀请码；投稿需要。CLI 与 MCP 调用同一套后端。</span>
        </p>
      </details>
    </section>

    <!-- 右：申请邀请码表单 -->
    <aside class="about-apply">
      <h2>
        <span data-ui-en>Need an invite code?</span>
        <span data-ui-zh style="display:none">需要邀请码？</span>
      </h2>
      <p class="about-apply-desc">
        <span data-ui-en>Submitting a style requires an invite code. Leave your email and we'll send one to you.</span>
        <span data-ui-zh style="display:none">投稿风格需要邀请码。留下邮箱，我们会发送给你。</span>
      </p>
      <form id="apply-form" class="about-apply-form">
        <input type="email" id="apply-email" placeholder="you@example.com" required />
        <button type="submit">
          <span data-ui-en>Request invite</span>
          <span data-ui-zh style="display:none">申请邀请码</span>
        </button>
      </form>
      <p class="about-apply-status" id="apply-status"></p>
      <p class="about-signoff">
        <span data-ui-en>Created and maintained by </span>
        <span data-ui-zh style="display:none">由 </span>
        <a href="https://github.com/QuasarG">QuasarG</a>
        <span data-ui-zh style="display:none"> 创建与维护</span>
      </p>
    </aside>
  </div>

  <script is:inline>
    // 锁定 body 不滚动（about 页设计为一屏）
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
    (function () {
      const form = document.getElementById('apply-form');
      const emailInput = document.getElementById('apply-email');
      const status = document.getElementById('apply-status');
      if (!form) return;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (!email) return;
        const btn = form.querySelector('button');
        if (btn) btn.disabled = true;
        status.textContent = '';
        status.className = 'about-apply-status';
        try {
          const resp = await fetch('/api/apply-invite.json', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, lang: document.documentElement.lang === 'zh-CN' ? 'zh' : 'en' }),
          });
          const data = await resp.json();
          if (resp.ok) {
            status.textContent = data.message || 'Application received.';
            status.classList.add('ok');
            emailInput.value = '';
          } else {
            status.textContent = data.error || 'Something went wrong.';
            status.classList.add('err');
          }
        } catch {
          status.textContent = 'Network error. Please try again.';
          status.classList.add('err');
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    })();
  </script>
</Base>
